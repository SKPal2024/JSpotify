<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jspotify.controller.AlbumCardController"
      alignment="CENTER"
      spacing="10"
      prefWidth="170"
      prefHeight="220"
      style="-fx-background-color: #181818;
             -fx-background-radius: 12;
             -fx-padding: 15;">

    <Rectangle fx:id="coverPlaceholder"
               width="130"
               height="130"
               arcWidth="10"
               arcHeight="10"/>

    <Label fx:id="albumTitleLabel"
           text="Album"
           wrapText="true"
           maxWidth="140"
           style="-fx-text-fill: white;
                  -fx-font-size: 16px;
                  -fx-font-weight: bold;"/>

    <Label fx:id="artistLabel"
           text="Artist"
           style="-fx-text-fill: #aaaaaa;
                  -fx-font-size: 13px;"/>

</VBox>