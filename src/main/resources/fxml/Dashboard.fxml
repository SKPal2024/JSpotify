<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jspotify.controller.DashboardController"
            style="-fx-background-color: #f5f5f5;">

    <!-- TOP BAR -->
    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="25"
              style="-fx-background-color: #181818;">

            <padding>
                <Insets top="18"
                        right="25"
                        bottom="18"
                        left="25"/>
            </padding>

            <Label text="JSpotify"
                   style="-fx-text-fill: white;
                          -fx-font-size: 30px;
                          -fx-font-weight: bold;"/>

            <Label fx:id="welcomeLabel"
                   text="Welcome"
                   style="-fx-text-fill: white;
                          -fx-font-size: 18px;"/>

        </HBox>

    </top>


    <!-- CENTER -->
    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background-color: transparent;">

            <VBox spacing="25">

                <padding>
                    <Insets top="35"
                            right="35"
                            bottom="35"
                            left="35"/>
                </padding>


                <!-- WELCOME -->
                <Label text="Welcome to JSpotify"
                       style="-fx-font-size: 32px;
                              -fx-font-weight: bold;"/>


                <Label fx:id="usernameLabel"
                       text="Username"
                       style="-fx-font-size: 18px;"/>


                <Label fx:id="roleLabel"
                       text="Role"
                       style="-fx-font-size: 16px;"/>


                <!-- ARTISTS -->
                <Label text="Artists"
                       style="-fx-font-size: 26px;
                              -fx-font-weight: bold;"/>


                <ScrollPane fitToHeight="true"
                            fitToWidth="true"
                            hbarPolicy="AS_NEEDED"
                            vbarPolicy="NEVER"
                            prefHeight="220"
                            style="-fx-background-color: transparent;">

                    <HBox fx:id="artistsContainer"
                          spacing="15"
                          alignment="CENTER_LEFT">

                    </HBox>

                </ScrollPane>


                <!-- ALBUMS -->
                <Label text="Albums"
                       style="-fx-font-size: 26px;
                              -fx-font-weight: bold;"/>


                <HBox fx:id="albumsContainer"
                      spacing="15"
                      alignment="CENTER_LEFT">

                </HBox>


                <!-- SONGS -->
                <Label text="Songs"
                       style="-fx-font-size: 26px;
                              -fx-font-weight: bold;"/>


                <VBox fx:id="songsContainer"
                      spacing="8">

                </VBox>


                <!-- LOGOUT -->
                <Button fx:id="logoutButton"
                        text="Log Out"
                        onAction="#handleLogout"
                        prefWidth="220"
                        maxWidth="220"/>

            </VBox>

        </ScrollPane>

    </center>

</BorderPane>