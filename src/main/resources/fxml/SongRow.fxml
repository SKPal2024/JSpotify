<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jspotify.controller.SongRowController"
      alignment="CENTER_LEFT"
      spacing="20"
      prefHeight="55"
      style="-fx-background-color: #181818;
             -fx-background-radius: 8;
             -fx-padding: 8 15;">

    <Button fx:id="playButton"
            text="▶"
            onAction="#handlePlay"
            prefWidth="45"/>

    <Label fx:id="songTitleLabel"
           text="Song Title"
           prefWidth="250"
           style="-fx-text-fill: white;
                  -fx-font-size: 15px;"/>

    <Label fx:id="durationLabel"
           text="0:00"
           prefWidth="70"
           style="-fx-text-fill: #aaaaaa;
                  -fx-font-size: 14px;"/>

</HBox>