<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jspotify.controller.ArtistCardController"
      alignment="CENTER"
      spacing="10"
      prefWidth="170"
      prefHeight="220"
      style="-fx-background-color: #181818;
             -fx-background-radius: 12;
             -fx-padding: 15;">

    <Circle fx:id="artistImagePlaceholder"
            radius="65"/>

    <Label fx:id="artistNameLabel"
           text="Artist"
           wrapText="true"
           alignment="CENTER"
           maxWidth="140"
           style="-fx-text-fill: white;
                  -fx-font-size: 17px;
                  -fx-font-weight: bold;"/>

    <Label text="Artist"
           style="-fx-text-fill: #aaaaaa;
                  -fx-font-size: 13px;"/>

</VBox>